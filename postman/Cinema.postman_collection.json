{
  "info": {
    "name": "Lumière Cinema – REST API và Resume Payment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Chạy sau khi seed dữ liệu và khởi động 9 service. Không hard-code ID. Luồng này tạo vé thật trong database demo, sử dụng thanh toán payOS."
  },
  "item": [
    {
      "name": "Đăng nhập khách hàng",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@gmail.com\",\n  \"password\": \"123456\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Đăng nhập thành công',()=>pm.response.to.have.status(200));",
              "pm.environment.set('token',pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Hồ sơ cá nhân",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "Danh sách phim",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/movies"
      }
    },
    {
      "name": "Danh sách rạp",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/cinemas"
      }
    },
    {
      "name": "Chọn suất chiếu từ dữ liệu thật",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/showtimes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const s=pm.response.json().data.find(s=>s.status==='AVAILABLE' && new Date(s.startAt)>new Date());",
              "pm.test('Có suất chiếu',()=>pm.expect(s).to.exist);",
              "if(s)pm.environment.set('showtimeId',s.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Lấy sơ đồ và giá ghế",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/showtime/{{showtimeId}}/seats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const seats=pm.response.json().data.seats.filter(s=>s.availability==='AVAILABLE');",
              "pm.test('Có ghế trống',()=>pm.expect(seats.length).to.be.above(0));",
              "if(seats.length)pm.environment.set('seatId',seats[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Tạo booking không gửi userId hoặc giá",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"showtimeId\": \"{{showtimeId}}\",\n  \"seatIds\": [\n    \"{{seatId}}\"\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Đã giữ ghế',()=>pm.response.to.have.status(201));",
              "pm.environment.set('bookingId',pm.response.json().data.id);",
              "pm.environment.set('expiredAt',pm.response.json().data.expiredAt);"
            ]
          }
        }
      ]
    },
    {
      "name": "Tạo hoặc lấy payment hiện tại",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/payments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"paymentMethod\": \"PAYOS\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('paymentId',pm.response.json().data.id);",
              "pm.environment.set('transactionCode',pm.response.json().data.transactionCode);"
            ]
          }
        }
      ]
    },
    {
      "name": "Rời thanh toán về trang phim",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/movies"
      }
    },
    {
      "name": "Vé của tôi gồm PENDING",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings"
      }
    },
    {
      "name": "Mở lại booking sau khi rời trang",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Không reset thời hạn giữ ghế',()=>pm.expect(pm.response.json().data.expiredAt).to.eql(pm.environment.get('expiredAt')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Tiếp tục đúng payment cũ",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/payments/booking/{{bookingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Không tạo payment mới',()=>pm.expect(String(pm.response.json().data.id)).to.eql(String(pm.environment.get('paymentId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "Quản trị xác nhận ngoại lệ",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/payments/{{paymentId}}/confirm",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Payment SUCCESS',()=>pm.expect(pm.response.json().data.status).to.eql('SUCCESS'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Xác nhận lần hai vẫn idempotent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/payments/{{paymentId}}/confirm",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cùng giao dịch',()=>pm.expect(pm.response.json().data.transactionCode).to.eql(pm.environment.get('transactionCode')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Xem vé đã xác nhận",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Booking CONFIRMED',()=>pm.expect(pm.response.json().data.status).to.eql('CONFIRMED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Thông báo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/notifications"
      }
    },
    {
      "name": "Đăng nhập quản trị",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"123456\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('token',pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Tài khoản quản lý",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/users"
      }
    },
    {
      "name": "Thanh toán quản lý",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/payments"
      }
    },
    {
      "name": "Phòng chiếu",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/rooms"
      }
    },
    {
      "name": "Thể loại",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/categories"
      }
    }
  ]
}

